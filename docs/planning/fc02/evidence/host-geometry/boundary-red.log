ult WindowsD3D12SurfaceProvider::acquire() noexcept { return {}; }\nvoid WindowsD3D12SurfaceProvider::release() noexcept {}\ncanvas::render::BackendSubmissionResult WindowsD3D12SurfaceProvider::lose() noexcept { return {}; }\ncanvas::render::BackendSubmissionResult WindowsD3D12SurfaceProvider::present() noexcept { return {}; }\ncanvas::render::BackendSubmissionResult WindowsD3D12SurfaceProvider::resize(std::uint32_t, std::uint32_t) noexcept { return {}; }\ncanvas::render::BackendSubmissionResult WindowsD3D12SurfaceProvider::readbackRgba(std::span<std::uint8_t>) noexcept { return {}; }\ncanvas::render::BackendSubmissionResult WindowsD3D12SurfaceProvider::advanceGeneration() noexcept { return {}; }\ncanvas::render::BackendSubmissionResult WindowsD3D12SurfaceProvider::activateBinding() noexcept { return {}; }\nvoid WindowsD3D12SurfaceProvider::deactivateBinding() noexcept {}\nvoid WindowsD3D12SurfaceProvider::setOverlayVisible(bool visible) noexcept {\n  visible_.store(visible, std::memory_order_release);\n}\n}  // namespace canvas::minimal_runtime_host\n#endif\n\n#pragma once\n\n#include "canvas/render/skia_surface_provider.hpp"\n\n#if defined(_WIN32)\n#define WIN32_LEAN_AND_MEAN\n#ifndef NOMINMAX\n#define NOMINMAX\n#endif\n#include <windows.h>\n#endif\n\n#include <cstdint>\n#include <atomic>\n#include <memory>\n\nnamespace canvas::minimal_runtime_host {\n\nclass WindowsD3D12SurfaceProvider final\n    : public canvas::render::SkiaSurfaceProvider {\n public:\n#if defined(_WIN32)\n  explicit WindowsD3D12SurfaceProvider(HWND owner,\n                                           bool attachToOwner = false) noexcept;\n#else\n  explicit WindowsD3D12SurfaceProvider(void*) noexcept {}\n#endif\n  ~WindowsD3D12SurfaceProvider() override;\n  [[nodiscard]] canvas::render::RenderTargetInfo describe() const noexcept override;\n  [[nodiscard]] canvas::render::SkiaSurfaceAcquireResult acquire() noexcept override;\n  void release() noexcept override;\n  [[nodiscard]] canvas::render::Back