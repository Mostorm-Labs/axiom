file(READ "${PROJECT_SOURCE_DIR}/sdk/version.json" _axiom_version_json)
string(JSON AXIOM_SDK_SEMVER GET "${_axiom_version_json}" version)
string(JSON _axiom_default_build GET "${_axiom_version_json}" buildNumber)
if(DEFINED ENV{AXIOM_BUILD_NUMBER})
  set(_axiom_default_build "$ENV{AXIOM_BUILD_NUMBER}")
endif()
set(AXIOM_BUILD_NUMBER "${_axiom_default_build}" CACHE STRING "SDK pipeline build number; 0 denotes local development")
if(NOT AXIOM_BUILD_NUMBER MATCHES "^(0|[1-9][0-9]*)$" OR AXIOM_BUILD_NUMBER GREATER 9007199254740991)
  message(FATAL_ERROR "AXIOM_BUILD_NUMBER must be a lossless nonnegative integer")
endif()
set(AXIOM_SDK_DISPLAY_VERSION "${AXIOM_SDK_SEMVER}.${AXIOM_BUILD_NUMBER}")
string(JSON _axiom_abi GET "${_axiom_version_json}" abi_version)
string(JSON _axiom_transport GET "${_axiom_version_json}" transport_version)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/sdk/version.json")
file(WRITE "${CMAKE_BINARY_DIR}/axiom-sdk-version.json"
  "{\"version\":\"${AXIOM_SDK_SEMVER}\",\"buildNumber\":${AXIOM_BUILD_NUMBER},\"displayVersion\":\"${AXIOM_SDK_DISPLAY_VERSION}\",\"abi_version\":${_axiom_abi},\"transport_version\":${_axiom_transport}}\n")
