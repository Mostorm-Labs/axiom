{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:platform-harness-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocolVersion", "messageId", "messageType", "sessionId", "sessionEpoch", "payload"],
  "properties": {
    "protocol": { "const": "axiom-platform-harness-exec-v1" },
    "protocolVersion": { "const": 1 },
    "messageId": { "type": "string", "pattern": "^msg:[0-9]{5,}$" },
    "messageType": {
      "enum": ["HELLO", "OPEN_SESSION", "OPEN_SESSION_RESULT", "ACTION_REQUEST", "ACTION_RECEIPT", "ACTION_COMPLETION", "EVENT_DRAFT", "SOURCE_LEASE_OPEN", "SOURCE_LEASE_CLOSE", "SOURCE_ATTEMPT", "FAULT_STATUS", "FENCE_STATUS", "CAPTURE_REQUEST", "CAPTURE_RESULT", "CLOSE_SESSION", "CLOSE_SESSION_RESULT", "ADAPTER_ERROR"]
    },
    "sessionId": { "type": "string", "pattern": "^session:[0-9]{3,}$" },
    "sessionEpoch": { "type": "string", "pattern": "^u64:[0-9a-f]{16}$" },
    "payload": { "type": "object" }
  }
}
