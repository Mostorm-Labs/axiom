{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:g3-gate-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "authority", "gate", "status", "sourceCommit", "branch", "generatorVersion", "wpLineage", "checks", "platforms", "issues", "inputSha256", "promotion"],
  "properties": {
    "format": {"const": "axiom-g3-gate-report-v1"},
    "formatVersion": {"const": 1},
    "authority": {"const": "G3_GATE_REPORT"},
    "gate": {"const": "G3"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "generatorVersion": {"type": "string", "minLength": 1},
    "wpLineage": {"type": "array", "minItems": 10, "items": {"type": "object"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "issues": {"type": "array", "items": {"type": "string"}},
    "inputSha256": {"type": "object"},
    "promotion": {"type": "object", "required": ["allowed", "reason"], "properties": {"allowed": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
