{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:pr-run-set:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "schema", "protocol", "semantic", "selectedPlatforms", "changedPaths", "selectionReason"],
  "properties": {
    "format": { "const": "axiom-pr-run-set-v1" },
    "formatVersion": { "const": 1 },
    "schema": { "const": true },
    "protocol": { "const": true },
    "semantic": { "const": true },
    "selectedPlatforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web", "windows", "android", "apple"] } },
    "changedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "selectionReason": { "enum": ["SAFE_ALL_UNKNOWN_PATH", "BROAD_VERIFICATION_BOUNDARY", "TARGETED_PLATFORM_ADAPTER", "EMPTY_CHANGESET_SAFE_ALL"] }
  }
}
