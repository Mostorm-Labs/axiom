{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:full-run-set:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "authority", "cadence", "sourceCommit", "schemaSha256", "corpusSha256", "runnerVersion", "runtimeVersion", "repeat", "seed", "requiredProfiles"],
  "properties": {
    "format": { "const": "axiom-full-run-set-v1" },
    "formatVersion": { "const": 1 },
    "authority": { "const": "G0_WIRING_ONLY" },
    "cadence": { "enum": ["NIGHTLY", "RELEASE"] },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runnerVersion": { "type": "string", "minLength": 1 },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "repeat": { "type": "integer" },
    "seed": { "type": "integer" },
    "requiredProfiles": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["profileKey", "platformFamily", "profileId", "requiredReality"], "properties": {
      "profileKey": { "enum": ["web", "windows", "android", "ios", "ipados"] },
      "platformFamily": { "enum": ["WEB", "WINDOWS", "ANDROID", "APPLE"] },
      "profileId": { "type": "string", "minLength": 1 },
      "requiredReality": { "enum": ["HOSTED", "PHYSICAL"] }
    } } }
  }
}
