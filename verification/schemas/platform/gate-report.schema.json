{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:gate-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "authority", "gate", "status", "sourceCommit", "branch", "schemaVersion", "generatorVersion", "corpus", "platforms", "checks", "lineage", "artifacts", "issues", "promotion"],
  "properties": {
    "format": { "const": "axiom-gate-report-v1" },
    "formatVersion": { "const": 1 },
    "authority": { "const": "G0_GATE_REPORT" },
    "gate": { "const": "G0" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "branch": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "corpus": { "type": "object", "additionalProperties": false, "required": ["schemaSha256", "corpusSha256", "runnerVersion", "runtimeVersion"], "properties": {
      "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "runnerVersion": { "type": "string", "minLength": 1 },
      "runtimeVersion": { "type": "string", "minLength": 1 }
    } },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["subject", "platformFamily", "profileId", "reality", "evidencePath", "environment"], "properties": {
      "subject": { "type": "string", "minLength": 1 },
      "platformFamily": { "type": ["string", "null"], "enum": ["WEB", "WINDOWS", "ANDROID", "APPLE", null] },
      "profileId": { "type": ["string", "null"] },
      "reality": { "enum": ["HOSTED", "PHYSICAL", "EMULATOR", "SIMULATOR", "NOT_APPLICABLE"] },
      "evidencePath": { "type": "string", "minLength": 1 },
      "environment": { "type": "object" }
    } } },
    "checks": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["level", "status", "applicable", "reason", "firstDivergence", "issues"], "properties": {
      "level": { "enum": ["E1", "E2", "E3", "E4"] },
      "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
      "applicable": { "type": "boolean" },
      "reason": { "type": "string", "minLength": 1 },
      "firstDivergence": { "type": ["object", "null"], "additionalProperties": false, "required": ["taskId", "field", "expected", "actual"], "properties": {
        "taskId": { "type": "string", "minLength": 1 }, "field": { "type": "string", "minLength": 1 }, "expected": { "type": "string" }, "actual": { "type": "string" }
      } },
      "issues": { "type": "array", "items": { "type": "string" } }
    } } },
    "lineage": { "type": "array", "minItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["taskId", "status", "evidencePath", "evidenceSha256"], "properties": {
      "taskId": { "type": "string", "pattern": "^GT-G0-(?:0[0-9]|1[0-5])$" },
      "status": { "enum": ["Not Started", "Analyzing", "Ready", "Implementing", "Validating", "Pass", "Fail", "Blocked"] },
      "evidencePath": { "type": "string", "minLength": 1 },
      "evidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    } } },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {
      "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    } } },
    "issues": { "type": "array", "items": { "type": "string" } },
    "promotion": { "type": "object", "additionalProperties": false, "required": ["allowed", "reason"], "properties": { "allowed": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 } } }
  }
}
