{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:semantic-bootstrap-summary:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "authority", "scope", "sourceCommit", "status", "tests", "corpusSha256", "limitations"],
  "properties": {
    "format": { "const": "axiom-semantic-bootstrap-summary-v1" },
    "formatVersion": { "const": 1 },
    "authority": { "const": "GT-G0-14_BOOTSTRAP_ONLY" },
    "scope": { "const": "POC01_HOST_CORE_OPERATION_REPLAY_DIGEST_PROJECTION" },
    "sourceCommit": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL", "INVALID_EVIDENCE"] },
    "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
