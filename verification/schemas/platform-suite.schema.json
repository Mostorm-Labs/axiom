{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:platform-suite:v1",
  "title": "Axiom Platform Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "requiredScenarioFormatVersion", "requiredRunnerProtocolVersion", "scenarios"],
  "properties": {
    "format": {"const": "axiom-platform-suite-v1"},
    "formatVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "requiredScenarioFormatVersion": {"const": 1},
    "requiredRunnerProtocolVersion": {"type": "integer", "minimum": 1},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
