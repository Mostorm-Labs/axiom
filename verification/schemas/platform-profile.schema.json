{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:platform-profile:v1",
  "title": "Axiom Platform Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "profileId", "platformFamily", "platformVariant", "capabilities", "realization"],
  "properties": {
    "format": {"const": "axiom-platform-profile-v1"},
    "formatVersion": {"const": 1},
    "profileId": {"type": "string", "minLength": 1},
    "platformFamily": {"enum": ["WEB", "WINDOWS", "ANDROID", "APPLE"]},
    "platformVariant": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][a-z0-9]+)+$"}
    },
    "realization": {"type": "object", "additionalProperties": true}
  }
}
