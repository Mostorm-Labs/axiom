{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:case:v1",
  "title": "Axiom Golden Vector Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "title", "status", "category", "authorityRefs", "entrypoint", "requiredCapabilities", "input", "expected", "capture", "blockedByOpenPolicy", "notes"],
  "properties": {
    "formatVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/requirementStatus"},
    "category": {"type": "string", "minLength": 1},
    "authorityRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entrypoint": {"enum": ["DECODE", "NORMALIZE", "VALIDATE", "ENCODE", "APPLY", "REPLAY", "ORDER_KEY_COMPARE", "ORDER_KEY_ALLOCATE"]},
    "requiredCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "input": {"$ref": "#/$defs/input"},
    "expected": {"$ref": "#/$defs/expected"},
    "capture": {"$ref": "#/$defs/capture"},
    "blockedByOpenPolicy": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "requirementStatus": {"enum": ["SPEC_REQUIREMENT", "FREEZE_CANDIDATE", "BENCHMARK_TARGET", "EXPERIMENTAL_TARGET", "OPEN"]},
    "stageName": {"enum": ["DECODE", "NORMALIZE", "VALIDATE", "APPLY", "PROJECTION", "ENCODE", "REPLAY", "ORDER_KEY_COMPARE", "ORDER_KEY_ALLOCATE", "HARNESS"]},
    "artifactPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "input": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "rootType", "artifact"],
          "properties": {
            "kind": {"enum": ["ENCODED_VALUE", "ENCODED_OPERATION"]},
            "rootType": {"type": "string", "minLength": 1},
            "artifact": {"$ref": "#/$defs/artifactPath"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "rootType", "artifact"],
          "properties": {
            "kind": {"const": "SEMANTIC_FIXTURE"},
            "rootType": {"type": "string", "minLength": 1},
            "artifact": {"$ref": "#/$defs/artifactPath"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "initialSnapshot", "operations"],
          "properties": {
            "kind": {"const": "REPLAY_STREAM"},
            "initialSnapshot": {"$ref": "#/$defs/artifactPath"},
            "operations": {"$ref": "#/$defs/artifactPath"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "artifact"],
          "properties": {
            "kind": {"const": "ORDER_KEY_ARGS"},
            "artifact": {"$ref": "#/$defs/artifactPath"}
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "terminalStage": {"$ref": "#/$defs/stageName"},
        "outcome": {"enum": ["ACCEPTED", "REJECTED", "UNSPECIFIED"]},
        "semanticErrorCategory": {"type": "string", "minLength": 1},
        "finalProjection": {"$ref": "#/$defs/artifactPath"},
        "canonicalBytes": {"$ref": "#/$defs/artifactPath"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stageName"}},
        "checkpoints": {"$ref": "#/$defs/checkpointPolicy"}
      }
    },
    "checkpointPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["NONE", "EVERY_OPERATION", "STRIDE", "EXPLICIT"]},
        "stride": {"type": "integer", "minimum": 1},
        "operationIndices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "includeFinal": {"type": "boolean"}
      }
    }
  }
}
