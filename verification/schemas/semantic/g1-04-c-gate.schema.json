{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:g1-04-c-gate:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "provenance", "gateId", "status", "resultRefs"],
  "properties": {
    "format": {"const": "axiom-g1-04-c-gate-v1"},
    "formatVersion": {"const": 1},
    "provenance": {"const": "GATE_EVIDENCE"},
    "gateId": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "resultRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorityRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sourceRef": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
