{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditoryworks:axiom:verification:corpus:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "corpusId", "semanticSchemaVersion", "referenceCodec", "projectionFormat", "caseRoots", "requiredRunnerProtocolVersion"],
  "properties": {
    "formatVersion": {"const": 1},
    "corpusId": {"type": "string", "minLength": 1},
    "semanticSchemaVersion": {"type": "integer", "minimum": 1},
    "referenceCodec": {"const": "axiom-canonical-protobuf-v1"},
    "projectionFormat": {"const": "axiom-verification-projection-v1"},
    "caseRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_/-]+$"}},
    "requiredRunnerProtocolVersion": {"const": 1}
  }
}
