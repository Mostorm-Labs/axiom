{
  "name": "@axiom/platform-harness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@axiom/platform-harness-protocol": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @axiom/platform-harness-protocol",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/web-adapter.test.mjs && npm run test:browser",
    "test:browser": "playwright test"
  }
}
