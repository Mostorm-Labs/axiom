{
  "name": "@mostorm/axiom",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "http://npm.nearhub.cc/",
    "tag": "latest"
  },
  "exports": {
    ".": {
      "types": "./axiom.d.mts",
      "import": "./axiom.mjs"
    }
  },
  "files": [
    "*.mjs",
    "internal/**",
    "api/**",
    "*.d.mts",
    "*.wasm",
