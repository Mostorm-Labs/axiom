+bool CanvasEditingRuntime::freezeEraseReplacement(const render::FrameState& frame,
+                                                  EraseReplacement& proof) const {
+  if(!historySceneReady() || frame.sceneGeneration!=semanticGeneration_.current() ||
+     frame.sceneReadToken.value()!=sceneRevision() || frame.viewId!=viewId_ ||
+     frame.surfaceGeneration.value()!=surface_.generation ||
+     frame.metricsGeneration.value()!=surface_.metricsGeneration) return false;
+  const auto& clip=frame.viewportClip;
+  if(clip.left!=0 || clip.top!=0 || clip.right!=frame.metrics.logicalWidth ||
+     clip.bottom!=frame.metrics.logicalHeight)return false;
+  proof.document=documentId_;proof.lifetime=eraseDisplayLifetime_;
+  proof.frame={frame.viewId,frame.frameId,frame.sceneReadToken.value(),
+      frame.sceneGeneration.value(),frame.surfaceGeneration,frame.metricsGeneration};
+  proof.fence=canonicalCommitFence();
+  proof.eligible.reserve(sealedEraseFeedback_.size());
+  proof.superseded.reserve(sealedEraseFeedback_.size());
+  for(const auto& entry:sealedEraseFeedback_) {
+    if(entry.document!=documentId_ || entry.view!=viewId_ || entry.lifetime!=proof.lifetime ||
+       entry.surface!=surface_.generation || entry.metrics!=surface_.metricsGeneration ||
+       entry.semantic>frame.sceneGeneration.value() ||
+       entry.commit.runtime_epoch!=proof.fence.runtime_epoch ||
+       entry.commit.ordinal>proof.fence.ordinal)continue;
+    proof.eligible.push_back(entry.serial);
+    const bool currentEffect=std::all_of(entry.masks.begin(),entry.masks.end(),[&](const auto& token){
+      const auto* object=sceneCoordinator_->runtimeScene().find(token.first);
+      return object && std::any_of(object->eraseMasks.begin(),object->eraseMasks.end(),
+          [&](const auto& mask){return mask.id==token.second;});
+    });
+    if(!currentEffect)proof.superseded.push_back(entry.serial);
+  }
+  return true;
+}
+
+bool CanvasEditingRuntime::associateEraseReplacement(std::uint64_t runtime,std::uint64_t lifetime,
+    std::uint64_t attachment,std::uint64_t work,const render::RuntimeFrameIdentity& frame) noexcept {
+  if(!submittedEraseReplacement_ || submittedEraseReplacement_->frame!=frame)return true;
+  auto& proof=*submittedEraseReplacement_;
+  if(!runtime||!lifetime||!attachment||!work || proof.document!=documentId_ ||
+     proof.lifetime!=eraseDisplayLifetime_ || !surface_.available ||
+     frame.surfaceGeneration.value()!=surface_.generation ||
+     frame.metricsGeneration.value()!=surface_.metricsGeneration)return false;
+  const std::array<std::uint64_t,4> identity{runtime,lifetime,attachment,work};
+  if(proof.associated)return proof.work==identity;
+  // Only attach actual successful work. Never rebuild/expand the frozen list.
+  proof.work=identity;proof.associated=true;return true;
+}
+
+void CanvasEditingRuntime::completeEraseReplacement(std::uint64_t runtime,std::uint64_t lifetime,
+    std::uint64_t attachment,std::uint64_t work,const render::RuntimeFrameIdentity& frame) noexcept {
+  if(!submittedEraseReplacement_)return;
+  const auto& proof=*submittedEraseReplacement_;
+  if(!proof.associated || proof.work!=std::array<std::uint64_t,4>{runtime,lifetime,attachment,work} ||
+     proof.frame!=frame || proof.document!=documentId_ || proof.lifetime!=eraseDisplayLifetime_ ||
+     !surface_.available || frame.surfaceGeneration.value()!=surface_.generation ||
+     frame.metricsGeneration.value()!=surface_.metricsGeneration)return;
+  sealedEraseFeedback_.erase(std::remove_if(sealedEraseFeedback_.begin(),sealedEraseFeedback_.end(),
+      [&](const auto& entry){
+        if(std::find(proof.eligible.begin(),proof.eligible.end(),entry.serial)==proof.eligible.end())return false;
+        ++replacedEraseFeedback_;
+        if(std::find(proof.superseded.begin(),proof.superseded.end(),entry.serial)!=proof.superseded.end())++supersededEraseFeedback_;
+        return true;
+      }),sealedEraseFeedback_.end());
+  submittedEraseReplacement_.reset();
+  // Qualified B may retire only its sealed roster. Active or later sealed C
+  // owns the target now, and cannot be globally cleared by B's old callback.
+  if(activeEraseFeedback_.empty() && sealedEraseFeedback_.empty() && !previewActive() &&
+     !selectionTransformActive() && !creationActive() && !regionSelectionActive() &&
+     !objectEraseFeedbackActive() && pendingCanonicalIdentities_.empty()) {
+    transientOverlayHandoffPending_=false;
+    if(previewProvider_)previewProvider_->setOverlayVisible(false);
+  }
+}
+
+void CanvasEditingRuntime::invalidateEraseDisplay() noexcept {
+  cancelledEraseDisplay_+=sealedEraseFeedback_.size();
+  activeEraseFeedback_.clear();sealedEraseFeedback_.clear();submittedEraseReplacement_.reset();
+  if(eraseDisplayLifetime_!=std::numeric_limits<std::uint64_t>::max())++eraseDisplayLifetime_;
+}
