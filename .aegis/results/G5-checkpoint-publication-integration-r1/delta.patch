+UsefulPasses usefulPasses(const semantic::CompactStrokeContent& content){
+    UsefulPasses result;
+    ink::CompactContourCompiler compiler(content.stroke.config);
+    const auto total=ink::compactLength(content.stroke.knots);
+    // Exercise the existing forced 256-knot checkpoint realization. These
+    // counts are actual emitted components, not a permissive 2*N allowance.
+    for(std::size_t at=0;at<content.stroke.knots.size();at+=256){
+        const auto count=std::min(std::size_t(256),content.stroke.knots.size()-at);
+        ink::CompactContour contour;
+        compiler.append(std::span(content.stroke.knots).subspan(at,count),total,contour);
+        if(at+count==content.stroke.knots.size())compiler.finish(total,contour);
+        const auto ribbons=contour.patches.empty()?0:contour.patches.size()-1;
+        const auto caps=contour.caps.size();
+        result.blocks.push_back({at,count,result.ribbons,result.ribbons+ribbons,result.caps,result.caps+caps});
+        result.ribbons+=ribbons;result.caps+=caps;
+        if(ribbons)result.ribbonInputs+=count;
+        if(caps)result.capInputs+=count;
+    }
+    return result;
+}
