+void SkiaRenderer::clearCompactCache() noexcept {
+    // Lifecycle calls need not have the provider context current. Defer GPU
+    // object release until that provider is acquired for its next opportunity.
+    compactInvalidAll_=true;compactInvalidCount_=0;
+    compactWork_.retainedBytes=0;compactWork_.temporaryBytes=0;
+}
+void SkiaRenderer::invalidateCompactSession(std::uint64_t session) noexcept {
+    if(compactInvalidAll_)return;
+    if(std::find(compactInvalidSessions_.begin(),compactInvalidSessions_.begin()+compactInvalidCount_,session)!=
+        compactInvalidSessions_.begin()+compactInvalidCount_)return;
+    if(compactInvalidCount_==compactInvalidSessions_.size()){clearCompactCache();return;}
+    compactInvalidSessions_[compactInvalidCount_++]=session;
+}
+void SkiaRenderer::applyCompactInvalidations() noexcept {
+    if(compactInvalidAll_){compactCache_.reset();legacyCompactCache_.reset();}
+    else for(std::size_t i=0;i<compactInvalidCount_;++i){
+        if(compactCache_)compactCache_->entries.erase(compactInvalidSessions_[i]);
+        if(legacyCompactCache_)legacyCompactCache_->entries.erase(compactInvalidSessions_[i]);
+    }
+    if(compactCache_&&compactCache_->entries.empty())compactCache_.reset();
+    if(legacyCompactCache_&&legacyCompactCache_->entries.empty())legacyCompactCache_.reset();
+    compactInvalidAll_=false;compactInvalidCount_=0;
+    compactWork_.retainedBytes=compactCache_?std::uint64_t(compactCache_->width)*compactCache_->height*4*compactCache_->entries.size():0;
+    compactWork_.temporaryBytes=compactCache_&&compactCache_->scratch?std::uint64_t(compactCache_->width)*compactCache_->height*4:0;
+}
+void SkiaRenderer::releaseRetiredCompactResources(SkiaSurfaceProvider& provider) noexcept {
+    const auto acquired=provider.acquire();
+    if(acquired.code!=SkiaSurfaceAcquireCode::kAcquired||!acquired.frame.surface)return;
+    // acquire selects this provider's GPU context. Invalidated cache pixels
+    // stay charged through their real last-use epoch after owner release.
+    if(!compactCache_||compactCache_->provider==&provider)applyCompactInvalidations();
+    serviceResourceRetirements();provider.release();
+}
