+        auto mask=e.record.eraseMasks.front();mask.id=ObjectId::fromUint64(900);auto& sweep=std::get<semantic::SweptCircleMask>(mask.geometry);
+        sweep.segments.front().p0.position.x+=25;e.record.eraseMasks.push_back(mask);}
