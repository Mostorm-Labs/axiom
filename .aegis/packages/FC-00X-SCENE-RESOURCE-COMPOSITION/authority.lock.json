  "frozen_scope": {
    "scene": "Reuse existing SceneBinding, IncrementalRuntimeCoordinator, FullSceneCompiler and RuntimeSceneProjection; add adapters/ports only where required for one shared composition.",
    "resources": "Use one pull-plus-notify model. The Document ResourceManifest is the authority for Image/Font/Brush resource id, kind, ResourceRevision, expected sha256 content hash, byte length and decode/layout metadata. At attach/open, composition receives a copied internal ResourceBindingSnapshot derived from that manifest; Host/provider supplies immutable bytes/results only and never becomes the metadata authority. Existing canonical BrushResourceBinding metadata must agree with the manifest entry. Missing manifest representation, missing expected hash, or mismatched metadata keeps a resource unverified/missing and cannot publish Ready. Runtime validates at the owner safe point.",
    "composition": "Per-instance manual-poll Runtime composition with full lifecycle and close protocol; no duplicate Document, Session, History, RuntimeScene or canonical write owner.",
    "consumers": "Windows first, then Web debug-on/off, using the same composition; Minimal core must not link Playground or Debug UI.",
    "android": "Build/APK/physical evidence deferred and non-blocking."
  },
